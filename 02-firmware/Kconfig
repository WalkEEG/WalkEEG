source "Kconfig.zephyr"

menu "Nordic UART BLE GATT service sample"

config BT_NUS_THREAD_STACK_SIZE
	int "Thread stack size"
	default 1024
	help
	  Stack size used in each of the two threads

config BT_NUS_UART_BUFFER_SIZE
	int "UART payload buffer element size"
	default 40
	help
	  Size of the payload buffer in each RX and TX FIFO element

config BT_NUS_SECURITY_ENABLED
	bool "Security"
	default y
	select BT_SMP
	help
	  Enable Bluetooth LE security for the UART service

config BT_NUS_UART_RX_WAIT_TIME
	int "Timeout for UART RX complete event"
	default 50000
	help
	  Wait for RX complete event time in microseconds

# SETTINGS/ZMS/NVS are upstream Zephyr symbols: enable via prj.conf, not here.


config WALKEEG_USE_ADS1293
	bool "Use TI ADS1293 3-channel ECG AFE (SPI) instead of AD8232"
	default y
	help
	  Streams 3 ECG leads (Lead I/II/III, 24-bit, 533 sps) from the TI
	  ADS1293 over SPI1. The AD8232 SAADC path stays compiled in but is
	  not sampled. Requires the ads1293 SPI node in the board overlay
	  (already present for nrf52840dk). Set to n to go back to AD8232.

config WALKEEG_DUAL_FRONTEND
	bool "Run AD8232 (SAADC) and ADS1293 (SPI) at the same time"
	depends on WALKEEG_USE_ADS1293
	default n
	help
	  Both front-ends are plugged into the same board:
	    frame CH0     = AD8232 OUT via SAADC (AIN0 / P0.02)
	    frame CH1..CH2 = ADS1293 ECG channel 1 and 2
	  The AD8232 runs at the runtime stream rate (SET_RATE), the ADS1293
	  keeps its own ODR; its samples are held between DRDY events, so the
	  CH1/CH2 traces step at the ADS1293 ODR instead of the frame rate.

endmenu
