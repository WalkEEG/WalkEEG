/*
 * NUS physical UART moved to free pins on the P12 header (avoiding P0.06/P0.08 commonly used by the main board/module)
 *
 *   P12 Pin25 = P0.13 = UART TX (transmitted by the 52840)
 *   P12 Pin26 = P0.12 = UART RX (received by the 52840)
 *
 * USB-TTL crossover wiring:
 *   USB-TTL RX  -> P0.13 (TX)
 *   USB-TTL TX  -> P0.12 (RX)
 *   USB-TTL GND -> GND (common ground is mandatory)
 *   Baud rate 115200 8N1
 *
 * Notes:
 * - Phone <-> 52840 goes over Bluetooth NUS (wireless) and does not use these UART pins
 * - PC serial terminal <-> 52840 goes over USB-TTL + P0.12/P0.13
 * - The main board's built-in COM port (J-Link CDC / CH340) still uses the default pins and cannot see this UART
 *
 * On the official DK, P0.13=LED1 and P0.12=Button2; they must be disabled so they do not contend with the UART pins.
 */

/ {
	chosen {
		nordic,nus-uart = &uart0;
	};
};

/* AD8232 ECG channel: AIN0 = P0.02 (P13 pin 8), gain 1/6 -> 0..3.6 V */
&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN0>; /* P0.02 */
	};
};

&button1 {
	status = "disabled";
};

&led0 {
	status = "disabled";
};

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 13)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 12)>;
			bias-pull-up;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 13)>,
				<NRF_PSEL(UART_RX, 0, 12)>;
			low-power-enable;
		};
		/delete-node/ group2;
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
};

/*
 * TI ADS1293 3-channel ECG AFE (SPI1).
 *
 *   SCLK  P1.00  (SPIM1 SCK)      -> ADS1293 SCLK
 *   MOSI  P1.01  (SPIM1 MOSI)     -> ADS1293 SDI
 *   MISO  P1.02  (SPIM1 MISO)     <- ADS1293 SDO
 *   CS    P1.03  (GPIO, act-low)  -> ADS1293 CSB
 *   DRDY  P1.04  (GPIO input)     <- ADS1293 DRDYB (data ready)
 *   RESET P1.05  (GPIO, act-low)  -> ADS1293 RSTB (optional)
 *
 * These pins do NOT overlap the AD8232 interface (P0.02 / P1.13-15)
 * or the UART (P0.12 / P0.13). AD8232 nodes above are left untouched.
 */
&pinctrl {
	ads1293_spi_default: ads1293_spi_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 0)>,
				<NRF_PSEL(SPIM_MOSI, 1, 1)>,
				<NRF_PSEL(SPIM_MISO, 1, 2)>;
		};
	};

	ads1293_spi_sleep: ads1293_spi_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 0)>,
				<NRF_PSEL(SPIM_MOSI, 1, 1)>,
				<NRF_PSEL(SPIM_MISO, 1, 2)>;
			low-power-enable;
		};
	};
};

&spi1 {
	status = "okay";
	pinctrl-0 = <&ads1293_spi_default>;
	pinctrl-1 = <&ads1293_spi_sleep>;
	pinctrl-names = "default", "sleep";
	/* CSB must be attached to the SPI controller node; this is required by Zephyr's cs-gpios convention */
	cs-gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;

	ads1293: ads1293@0 {
		compatible = "ti,ads1293";
		reg = <0>;
		spi-max-frequency = <4000000>;
		drdy-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
		/* CJMCU-1293 has no RESET pin; the driver uses CONFIG=0 soft reset. */
	};
};
