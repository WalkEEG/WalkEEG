{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "NCS: Build (west build)",
            "type": "shell",
            "command": "west build -b nrf52840dk/nrf52840 -d build",
            "options": {
                "cwd": "${workspaceFolder}/02-firmware"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Build WalkEEG firmware"
        },
        {
            "label": "NCS: Flash (west flash)",
            "type": "shell",
            "command": "west flash -d build",
            "options": {
                "cwd": "${workspaceFolder}/02-firmware"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Flash to nRF52840 DK"
        },
        {
            "label": "NCS: Build + Flash",
            "type": "shell",
            "command": "west build -b nrf52840dk/nrf52840 -d build && west flash -d build",
            "options": {
                "cwd": "${workspaceFolder}/02-firmware"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Build and flash"
        },
        {
            "label": "NCS: Clean Build",
            "type": "shell",
            "command": "west build -b nrf52840dk/nrf52840 -d build -p always",
            "options": {
                "cwd": "${workspaceFolder}/02-firmware"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean and rebuild"
        }
    ]
}
