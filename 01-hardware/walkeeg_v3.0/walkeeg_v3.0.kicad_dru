(version 1)

# ---- WalkEEG v3.0 custom design rules ----

# TP array pitch 2.54mm < PinSocket_1x01 courtyard half-width (1.77mm); courtyard overlap allowed
# (pad clearance 0.84mm has no practical effect; courtyard overlap occurs only in the TP array)
(rule "TP courtyard exemption"
  (constraint courtyard_clearance (min -1.2mm)))

# Power nets: minimum trace width 0.4mm (VBUS/3V3/GND trunk)
(rule "Power trace width"
  (condition "A.NetClass == 'Power'")
  (constraint track_width (min 0.4mm)))

# Analog nets: minimum clearance 0.25mm (ADC input traces, against digital crosstalk)
(rule "Analog spacing"
  (condition "A.NetClass == 'Analog' || B.NetClass == 'Analog'")
  (constraint clearance (min 0.25mm)))
